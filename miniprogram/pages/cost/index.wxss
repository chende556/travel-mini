/* 费用汇总页 */
.summary-header {
  text-align: center;
  padding: 40rpx 24rpx;
}

.summary-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.total-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.total-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #e64340;
}

.total-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.total-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 类目卡片 */
.category-list {
  margin-top: 20rpx;
}

.category-card {
  margin-bottom: 20rpx;
}

.category-header {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 12rpx;
}

.category-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.category-total {
  font-size: 30rpx;
  font-weight: bold;
  color: #e64340;
}

/* 明细 */
.cost-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  padding-left: 44rpx;
}

.cost-name {
  font-size: 26rpx;
  color: #666;
}

.cost-amount {
  font-size: 26rpx;
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}
