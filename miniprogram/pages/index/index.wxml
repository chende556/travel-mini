<!-- 自定义顶部导航栏 (加黑加大: 我的行程本) -->
<view class="custom-nav-bar" style="padding-top: {{statusBarHeight || 20}}px; height: {{navHeight || 44}}px;">
  <view class="custom-nav-title">我的行程本</view>
</view>
<!-- 占位垫高 -->
<view style="height: {{(statusBarHeight || 20) + (navHeight || 44)}}px;"></view>

<!-- 行程列表页 -->
<view class="container main-page">
  <!-- 未登录提示 -->
  <view class="login-tip" wx:if="{{!isLogin}}">
    <button class="btn-primary" bindtap="onLogin">微信登录</button>
  </view>

  <!-- 行程列表主体 -->
  <view wx:if="{{isLogin}}">
    <!-- 1. 切换标签：[ 我发起的 ] [ 我参与的 ] -->
    <view class="segmented-tabs-container">
      <view class="segmented-tab {{activeTab === 'created' ? 'active' : ''}}" bindtap="onTabChange" data-tab="created">我发起的</view>
      <view class="segmented-tab {{activeTab === 'joined' ? 'active' : ''}}" bindtap="onTabChange" data-tab="joined">我参与的</view>
    </view>

    <!-- 2. 搜索框与新建按钮行 -->
    <view class="search-create-row">
      <view class="search-input-box">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索行程" value="{{searchKeyword}}" bindinput="onSearchInput" />
        <text class="clear-icon" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</text>
      </view>
      <view class="quick-add-btn" bindtap="onScanJoin">扫码加入</view>
      <view class="quick-add-btn" bindtap="onAddTrip">+ 新建</view>
    </view>

    <!-- 3. 行程卡片列表 (高美感莫兰迪绿/灰调盖板 + 白底信息区) -->
    <view class="trip-list-v2">
      <view class="trip-card-v2 {{item.status_class === 'completed' || item.status === 'completed' ? 'completed-card' : ''}}" wx:for="{{trips}}" wx:key="id" bindtap="onTripDetail" data-id="{{item.id}}">
        <!-- 上半部分：封面盖板 -->
        <view class="card-cover-banner {{item.status_class === 'completed' || item.status === 'completed' ? 'completed-cover' : ''}}">
          <!-- 状态小标签 (规划中 / 进行中 / 已完成) -->
          <view class="status-badge {{item.status_class}}">{{item.status_text}}</view>

          <!-- 右上角天数标签 (例: 2天) -->
          <view class="duration-badge">{{item.total_days}}天</view>

          <!-- 底部成员头像与职责堆叠 -->
          <view class="cover-bottom-row" catchtap="stopBubble">
            <view class="avatar-stack">
              <block wx:for="{{item.trip_members || members}}" wx:for-item="m" wx:key="id" wx:if="{{index < 5}}">
                <image class="member-avatar-mini" src="{{m.avatar_url || (m.nickname === '潮唧唧' ? '/images/1_jiji.jpg' : m.nickname === '飞机' ? '/images/2_feiji.jpg' : m.nickname === '宝哥' ? '/images/3_baoge.jpg' : m.nickname === '平胸' ? '/images/4_pingxion.jpg' : '/images/default-avatar.jpg')}}" mode="aspectFill" catchtap="onMemberTap" data-member="{{m}}" data-trip="{{item}}"></image>
              </block>
              <view class="avatar-add-btn" catchtap="onShowInviteQr" data-trip="{{item}}" wx:if="{{item.is_creator}}">+</view>
            </view>
          </view>
        </view>

        <!-- 下半部分：白底信息区 -->
        <view class="card-info-body">
          <view class="info-title-row">
            <text class="trip-title-v2">{{item.title}}</text>
            <view class="memory-btn-pill" catchtap="onGoToMemory" data-id="{{item.id}}" wx:if="{{item.status_class === 'completed' || item.status === 'completed'}}">
              🎬 旅行回忆 ›
            </view>
          </view>

          <view class="info-meta-row">
            <text class="meta-item"><text class="svg-inline-icon icon-user"></text>{{item.trip_members ? item.trip_members.length : 1}}人</text>
            <text class="meta-item"><text class="svg-inline-icon icon-calendar"></text>{{item.formatted_date_range}}</text>
            <text class="meta-item countdown-tag" wx:if="{{item.status_class === 'planning' && item.countdown > 0}}"><text class="svg-inline-icon icon-clock"></text>{{item.countdown}}天后出发</text>
            <text class="meta-item ongoing-tag" wx:if="{{item.status_class === 'ongoing'}}"><text class="svg-inline-icon icon-rocket"></text>进行中</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{trips.length === 0 && !loading}}">
        <view class="icon">✈️</view>
        <text class="text">{{activeTab === 'created' ? '还没有发起的行程' : '还没有参与的行程'}}</text>
        <view class="btn-create-empty" bindtap="onAddTrip" wx:if="{{activeTab === 'created'}}">新建行程</view>
      </view>
    </view>
  </view>
</view>

<!-- 首次设置昵称弹窗 -->
<view class="nickname-modal-overlay" wx:if="{{showNicknamePicker}}">
  <view class="nickname-modal-card" catchtap="stopBubble">
    <view class="modal-title">首次使用请设置资料</view>
    <view class="modal-sub">方便旅途中队友识别您的身份</view>
    <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-preview-circle" src="{{tempAvatarUrl || '/images/default-avatar.jpg'}}" mode="aspectFill"></image>
      <text class="avatar-choose-text">点击选择头像</text>
    </button>
    <input class="nickname-input" type="nickname" placeholder="输入或微信快捷填入昵称" value="{{tempNickname}}" bindinput="onInputNickname" />
    <button class="btn-primary modal-save-btn" bindtap="onSubmitProfile">确定使用</button>
  </view>
</view>

<!-- 邀请二维码弹窗 -->
<view class="invite-overlay" wx:if="{{showInviteModal}}" bindtap="onCloseInvite">
  <view class="invite-modal" catchtap="stopBubble">
    <view class="invite-title"><text class="svg-inline-icon icon-mail"></text> 邀请队友加入行程</view>
    <view class="invite-trip-info" wx:if="{{inviteTripTitle}}">
      <view class="invite-trip-name">{{inviteTripTitle}}</view>
      <view class="invite-trip-dates"><text class="svg-inline-icon icon-calendar"></text> {{inviteTripDates}}</view>
    </view>
    <image class="invite-qrcode" src="{{inviteQrCodeUrl}}" mode="aspectFit" wx:if="{{inviteQrCodeUrl}}" show-menu-by-longpress></image>
    <view class="invite-loading" wx:else>二维码生成中...</view>
    <view class="invite-tip"><text class="svg-inline-icon icon-info"></text> 长按二维码可保存到相册或发送给好友（4小时内有效）</view>
    <button class="btn-primary invite-close-btn" bindtap="onCloseInvite">我知道了</button>
  </view>
</view>
