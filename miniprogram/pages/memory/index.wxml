<!-- 回忆模式页面 -->
<view class="memory-page">

  <!-- 1. 最顶部：标题 Header + 旅行档案简报 (天数，城市数，景点数，照片数) -->
  <view class="memory-top-section card-box">
    <!-- 顶部标题区 (全新优雅高级艺术字体) -->
    <view class="header-title-box">
      <view class="header-top-tag">
        <text class="svg-inline-icon icon-camera"></text>
        <text class="tag-txt">MEMORY LOG · 旅途回忆录</text>
      </view>
      <view class="memory-luxury-title">{{trip.title || trip.destination || '旅途故事'}}</view>
      <view class="memory-meta-sub" wx:if="{{trip.start_date}}">
        <text class="svg-inline-icon icon-pin"></text>
        <text class="meta-dest">{{trip.destination || '浪漫目的地'}}</text>
        <text class="meta-dot">·</text>
        <text class="svg-inline-icon icon-calendar"></text>
        <text class="meta-date">{{trip.start_date}} ~ {{trip.end_date}}</text>
      </view>
    </view>

    <!-- 旅行档案简报 Grid: 天数，城市数，景点数，照片数 -->
    <view class="briefing-box">
      <view class="briefing-title">
        <text class="svg-inline-icon icon-wallet"></text> 旅行档案简报
      </view>
      <view class="briefing-grid">
        <view class="brief-item">
          <view class="brief-num green-num">{{stats.days || 1}}</view>
          <view class="brief-label">天数</view>
        </view>
        <view class="brief-item">
          <view class="brief-num amber-num">{{stats.cities || routeNodes.length || 1}}</view>
          <view class="brief-label">城市数</view>
        </view>
        <view class="brief-item">
          <view class="brief-num blue-num">{{stats.places || 0}}</view>
          <view class="brief-label">景点数</view>
        </view>
        <view class="brief-item">
          <view class="brief-num rose-num">{{stats.photos || 0}}</view>
          <view class="brief-label">照片数</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 2. 下面：精彩相册 -->
  <view class="photos-section card-box">
    <view class="section-header-row">
      <text class="section-title"><text class="svg-inline-icon icon-camera"></text> 精彩相册</text>
      <text class="section-sub">共 {{stats.photos || 0}} 张珍贵留影</text>
    </view>

    <view class="photos-grid" wx:if="{{currentPagePhotos && currentPagePhotos.length > 0}}">
      <view class="photo-grid-item" wx:for="{{currentPagePhotos}}" wx:key="id" bindtap="onPreviewPhoto" data-index="{{photoPageIndex * 9 + index}}">
        <image src="{{item.image_url}}" mode="aspectFill"></image>
      </view>
    </view>

    <view class="empty-photos-tip" wx:if="{{!photos || photos.length === 0}}">
      <view class="svg-icon icon-other empty-svg"></view>
      <text class="empty-text">该行程暂无照相记录，去行程详情里上传照片吧</text>
    </view>

    <view class="photos-controls" wx:if="{{photos && photos.length > 0}}">
      <view class="page-btn {{photoPageIndex <= 0 ? 'disabled' : ''}}" bindtap="onPrevPage">‹ 上一页</view>
      <text class="page-info">{{photoPageIndex + 1}} / {{totalPhotoPages}}</text>
      <view class="page-btn {{photoPageIndex >= totalPhotoPages - 1 ? 'disabled' : ''}}" bindtap="onNextPage">下一页 ›</view>
      <view class="slideshow-btn" bindtap="onStartSlideshow">▶ 播放影集</view>
    </view>
  </view>

  <!-- 3. 再下面：足迹路线 (腾讯地图) -->
  <view class="map-section card-box" wx:if="{{markers && markers.length > 0}}">
    <view class="section-header-row">
      <text class="section-title"><text class="svg-inline-icon icon-map"></text> 专属足迹路线</text>
      <text class="section-sub" wx:if="{{totalDistance > 0}}">全程约 {{totalDistance}} 公里</text>
    </view>
    <map class="memory-map"
      id="memoryMap"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      markers="{{mapMarkers}}"
      polyline="{{polyline}}"
      scale="{{mapScale}}"
      show-location="{{false}}">
    </map>
  </view>

  <!-- 幻灯片模式（全屏覆盖） -->
  <view class="slideshow-overlay" wx:if="{{showSlideshow}}" bindtap="onStopSlideshow">
    <swiper class="slideshow-swiper" autoplay circular interval="3000" duration="800">
      <swiper-item wx:for="{{photos}}" wx:key="id">
        <image class="slideshow-image" src="{{item.image_url}}" mode="aspectFit"></image>
        <view class="slideshow-info">
          <text class="slideshow-day">Day {{item.day_number}}</text>
          <text class="slideshow-place">{{item.place_name}}</text>
        </view>
      </swiper-item>
    </swiper>
    <view class="slideshow-close">点击任意位置退出影集播放</view>
  </view>

</view>
