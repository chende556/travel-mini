<!-- 自定义顶部导航栏 (个人中心) -->
<view class="custom-nav-bar" style="padding-top: {{statusBarHeight || 20}}px; height: {{navHeight || 44}}px;">
  <view class="custom-nav-title">个人中心</view>
</view>
<view style="height: {{(statusBarHeight || 20) + (navHeight || 44)}}px;"></view>

<!-- 我的页面 -->
<view class="container">
  <view class="profile card">
    <image class="avatar" src="{{avatarSrc || '/images/default-avatar.jpg'}}" mode="aspectFill" bindtap="onAvatarTap"></image>
    <view class="nickname">{{userInfo.nickname || '微信用户'}}</view>
    <view class="user-id-badge" wx:if="{{userInfo.id}}">ID: {{userInfo.id}}</view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="onAvatarTap">
      <text>修改资料（头像 / 昵称）</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于我们</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="onLogout">
      <text>退出登录</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>

<!-- 头像大图预览 -->
<view class="preview-overlay" wx:if="{{showPreview}}" catchtap="onClosePreview">
  <image class="preview-image" src="{{avatarSrc || '/images/default-avatar.jpg'}}" mode="aspectFit"></image>
</view>
