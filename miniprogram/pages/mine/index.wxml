<!-- 我的页面 -->
<view class="container">
  <view class="profile card">
    <image class="avatar" src="/images/group-avatar.jpg" mode="aspectFill" bindtap="onPreviewAvatar"></image>
    <view class="nickname">我和青春有个约定</view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="onAbout">
      <text>关于</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="onLogout">
      <text>退出登录</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>

<!-- 头像大图预览 -->
<view class="preview-overlay" wx:if="{{showPreview}}" catchtap="onClosePreview">
  <image class="preview-image" src="/images/group-avatar.jpg" mode="aspectFit"></image>
</view>
