.publish-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.my-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

.publish-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.publish-btn {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.moment-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.moment-author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.privacy-badge {
  margin-left: auto;
  font-size: 20rpx;
  color: #6b8e23;
  background: #f4f7f2;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e2ebd8;
  white-space: nowrap;
}

.privacy-notice {
  font-size: 22rpx;
  color: #8c7f79;
  background: #fdfbf7;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.moment-time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.moment-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.moment-images {
  display: grid;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.grid-1 {
  grid-template-columns: 1fr;
}

.grid-1 .moment-img {
  width: 100%;
  max-height: 400rpx;
  border-radius: 16rpx;
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
}

.grid-2 .moment-img, .grid-3 .moment-img {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
}

.grid-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

.moment-location {
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 16rpx;
}

.moment-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.action-btn.liked {
  color: #ff4d4f;
}

.action-btn.owner-btn {
  color: #8eaec7;
}

.action-btn.owner-btn.danger {
  color: #e57373;
}

.likes-box {
  background: #f8f9fa;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #555;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.comments-box {
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.comment-row {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.comment-author {
  font-weight: bold;
  color: #576b95;
}

.comment-text {
  color: #333;
}

.comment-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.comment-input {
  flex: 1;
  background: #f2f3f5;
  height: 64rpx;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.btn-send-sub {
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
}

/* 发布弹窗 */
.publish-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: flex-start;
  padding-top: 10vh;
}

.publish-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  max-height: 80vh;
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.publish-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.pub-images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.pub-img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.pub-img-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.del-img-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 18rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
}

.pub-add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.location-picker-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #555;
}

.visibility-picker-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  color: #555;
}

.loc-icon {
  margin-right: 12rpx;
}

.loc-text {
  flex: 1;
}

.loc-arrow {
  color: #bbb;
}

.pub-submit-btn {
  width: 100% !important;
  border-radius: 40rpx;
}
