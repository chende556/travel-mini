<!-- 照片集 / 旅途相册 -->
<view class="container">
  <!-- 1. 特定行程的照片集 -->
  <block wx:if="{{tripId}}">
    <view class="page-title">{{tripTitle}} · 照片集</view>

    <view class="day-group" wx:for="{{days}}" wx:key="day_number">
      <view class="day-header">
        <text class="day-badge">Day {{item.day_number}}</text>
        <text class="day-date">{{item.date}}</text>
      </view>

      <view class="place-group" wx:for="{{item.places}}" wx:for-item="place" wx:key="place_name">
        <view class="place-label">📍 {{place.place_name}}</view>
        <view class="photo-grid">
          <view class="photo-item" wx:for="{{place.photos}}" wx:for-item="photo" wx:key="id" bindtap="onPreview" data-place="{{place}}" data-photo-index="{{index}}">
            <image src="{{photo.image_url}}" mode="aspectFill"></image>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{days.length === 0 && !loading}}">
      <text>还没有照片，去行程里上传吧</text>
    </view>
  </block>

  <!-- 2. 全局旅途相册 TabBar -->
  <block wx:else>
    <view class="page-title">📷 旅途照片墙</view>

    <view class="trip-photos-card card" wx:for="{{trips}}" wx:for-item="tItem" wx:key="trip_id">
      <view class="trip-card-header">
        <text class="trip-card-title">🚗 {{tItem.trip_title}}</text>
      </view>

      <view class="day-group" wx:for="{{tItem.days}}" wx:key="day_number">
        <view class="day-header">
          <text class="day-badge">Day {{item.day_number}}</text>
          <text class="day-date">{{item.date}}</text>
        </view>

        <view class="place-group" wx:for="{{item.places}}" wx:for-item="place" wx:key="place_name">
          <view class="place-label">📍 {{place.place_name}}</view>
          <view class="photo-grid">
            <view class="photo-item" wx:for="{{place.photos}}" wx:for-item="photo" wx:key="id" bindtap="onPreview" data-place="{{place}}" data-photo-index="{{index}}">
              <image src="{{photo.image_url}}" mode="aspectFill"></image>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{trips.length === 0 && !loading}}">
      <text>还没有照片，快去上传第一张旅行照吧！</text>
    </view>
  </block>
</view>
