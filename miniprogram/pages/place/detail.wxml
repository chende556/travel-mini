<!-- 地点详情 + 照片墙 -->
<view class="container">
  <!-- 地点信息 -->
  <view class="place-header card">
    <view class="place-type-badge">{{place.type_display}}</view>
    <view class="place-name">{{place.name}}</view>
    <view class="place-map-btn" wx:if="{{place.latitude}}" bindtap="onOpenMap"><text class="svg-inline-icon icon-map"></text>查看地图位置</view>
    <view class="place-address" wx:if="{{place.address}}"><text class="svg-inline-icon icon-pin"></text>{{place.address}}</view>
    
    <!-- 精致莫兰迪天气预报卡片 -->
    <view class="weather-card-box" wx:if="{{weather.text}}">
      <view class="weather-main-row">
        <text class="weather-text">{{weather.text}}</text>
        <text class="weather-temp">{{weather.tempMin}}~{{weather.tempMax}}°C</text>
      </view>
      <view class="weather-meta-row">
        <view class="weather-chip">
          <text class="svg-inline-icon icon-droplet"></text>
          <text>湿度 {{weather.humidity}}%</text>
        </view>
        <view class="weather-chip">
          <text class="svg-inline-icon icon-wind"></text>
          <text>{{weather.windDir}} {{weather.windScale}}级</text>
        </view>
        <view class="weather-chip" wx:if="{{weather.uvIndex}}">
          <text class="svg-inline-icon icon-sun"></text>
          <text>UV {{weather.uvIndex}}</text>
        </view>
      </view>
    </view>

    <view class="place-time" wx:if="{{place.start_time}}"><text class="svg-inline-icon icon-clock"></text>{{place.start_time}}{{place.end_time ? ' ~ ' + place.end_time : ''}}</view>
    <view class="place-cost" wx:if="{{place.cost}}"><text class="svg-inline-icon icon-wallet"></text>¥{{place.cost}}</view>
    <view class="place-note" wx:if="{{place.note}}">{{place.note}}</view>
    <view class="place-actions">
      <view class="action-btn" bindtap="onEditPlace"><text class="svg-inline-icon icon-edit"></text>编辑</view>
      <view class="action-btn danger" bindtap="onDeletePlace"><text class="svg-inline-icon icon-trash"></text>删除</view>
    </view>
  </view>

  <!-- 照片墙 -->
  <view class="photo-section card">
    <view class="section-header">
      <text class="section-title"><text class="svg-inline-icon icon-camera"></text>照片墙 ({{photos.length}})</text>
      <view class="upload-btn" bindtap="onUploadPhoto">上传照片</view>
    </view>

    <view class="photo-grid" wx:if="{{photos.length > 0}}">
      <view class="photo-item" wx:for="{{photos}}" wx:key="id">
        <image src="{{item.image_url}}" mode="aspectFill" bindtap="onPreviewPhoto" data-index="{{index}}"></image>
        <view class="photo-delete" catchtap="onDeletePhoto" data-id="{{item.id}}">×</view>
      </view>
    </view>

    <view class="empty-photo" wx:else>
      <text>还没有照片，点击上方按钮上传</text>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section">
    <view class="comment-title">💬 评论</view>
    <view class="comment-input-row">
      <input class="comment-input" placeholder="说点什么..." value="{{commentText}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="onSendComment" />
      <view class="comment-send" bindtap="onSendComment">发送</view>
    </view>
    <view class="comment-list">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id" bindtap="onReplyComment" data-name="{{item.nickname}}" bindlongpress="onDeleteComment" data-id="{{item.id}}">
        <view class="comment-body">
          <text class="comment-author">{{item.nickname || '匿名'}}：</text>
          <text class="comment-content">{{item.content}}</text>
          <text class="comment-time">{{item.created_at}}</text>
        </view>
      </view>
      <view class="comment-empty" wx:if="{{comments.length === 0}}">
        <text>还没有评论~</text>
      </view>
    </view>
  </view>
</view>
