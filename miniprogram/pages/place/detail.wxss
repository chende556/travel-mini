/* 地点详情页 */
.place-header {
  margin-bottom: 30rpx;
}

.place-type {
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 8rpx;
}

.place-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.place-address,
.place-time,
.place-cost {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.place-note {
  font-size: 26rpx;
  color: #333;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.place-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.action-btn {
  font-size: 24rpx;
  color: #07c160;
  padding: 6rpx 16rpx;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
}

.action-btn.danger {
  color: #e64340;
  border-color: #e64340;
}

/* 照片区域 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.upload-btn {
  font-size: 24rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.photo-item {
  position: relative;
}

.photo-item image {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
  border-radius: 50%;
}

.empty-photo {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

/* 查看地图按钮 */
.place-map-btn {
  font-size: 26rpx;
  color: #07c160;
  margin-top: 8rpx;
}
