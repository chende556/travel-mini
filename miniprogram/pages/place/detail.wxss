.place-header {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.place-type-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
  background: #ecfdf5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.place-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.place-map-btn {
  font-size: 26rpx;
  color: #059669;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.place-address,
.place-time,
.place-cost {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

/* 莫兰迪天气预报精致卡片 */
.weather-card-box {
  background: linear-gradient(135deg, #f0fdf4, #e0f2fe);
  border: 1rpx solid #bae6fd;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  margin: 16rpx 0;
}

.weather-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.weather-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0369a1;
}

.weather-temp {
  font-size: 26rpx;
  font-weight: 600;
  color: #0c4a6e;
}

.weather-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.weather-chip {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #0369a1;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.place-note {
  font-size: 26rpx;
  color: #333;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.place-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.action-btn {
  font-size: 24rpx;
  color: #07c160;
  padding: 6rpx 16rpx;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
}

.action-btn.danger {
  color: #e64340;
  border-color: #e64340;
}

/* 照片区域 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.upload-btn {
  font-size: 24rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.photo-item {
  position: relative;
}

.photo-item image {
  width: 100%;
  height: 220rpx;
  border-radius: 8rpx;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
  border-radius: 50%;
}

.empty-photo {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

/* 查看地图按钮 */
.place-map-btn {
  font-size: 26rpx;
  color: #07c160;
  margin-top: 8rpx;
}
