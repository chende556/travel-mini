<!-- 添加/编辑地点 -->
<view class="container">
  <view class="form card">
    <!-- 地点类型 -->
    <view class="form-item">
      <text class="form-label">类型 *</text>
      <view class="type-selector">
        <view class="type-option {{type === 'hotel' ? 'active' : ''}}" bindtap="onSelectType" data-type="hotel">🏨 酒店</view>
        <view class="type-option {{type === 'scenic' ? 'active' : ''}}" bindtap="onSelectType" data-type="scenic">🏞️ 景点</view>
        <view class="type-option {{type === 'restaurant' ? 'active' : ''}}" bindtap="onSelectType" data-type="restaurant">🍽️ 餐厅</view>
        <view class="type-option {{type === 'transport' ? 'active' : ''}}" bindtap="onSelectType" data-type="transport">🚗 交通</view>
        <view class="type-option {{type === 'other' ? 'active' : ''}}" bindtap="onSelectType" data-type="other">🛍️ 其他</view>
      </view>
    </view>

    <!-- 名称 -->
    <view class="form-item">
      <text class="form-label">名称 *</text>
      <input class="form-input" placeholder="如：东京塔" value="{{name}}" bindinput="onInputName" />
    </view>

    <!-- 地址 -->
    <view class="form-item">
      <text class="form-label">地址</text>
      <input class="form-input" placeholder="详细地址" value="{{address}}" bindinput="onInputAddress" />
    </view>

    <!-- 地图选点 -->
    <view class="form-item">
      <view class="location-btn" bindtap="onChooseLocation">
        <text>📍 {{latitude ? '已选择位置' : '选择地图位置'}}</text>
        <text class="arrow" wx:if="{{!latitude}}">></text>
        <text class="location-clear" wx:if="{{latitude}}" catchtap="onClearLocation">✕</text>
      </view>
    </view>

    <!-- 时间 -->
    <view class="form-item form-row">
      <view class="form-half">
        <text class="form-label">开始时间</text>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="form-picker">{{startTime || '选择'}}</view>
        </picker>
      </view>
      <view class="form-half">
        <text class="form-label">结束时间</text>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="form-picker">{{endTime || '选择'}}</view>
        </picker>
      </view>
    </view>

    <!-- 费用 -->
    <view class="form-item">
      <text class="form-label">费用（元）</text>
      <input class="form-input" type="digit" placeholder="0.00" value="{{cost}}" bindinput="onInputCost" />
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="其他信息..." value="{{note}}" bindinput="onInputNote" />
    </view>
  </view>

  <view class="btn-primary submit-btn" bindtap="onSubmit">
    {{isEdit ? '保存修改' : '添加地点'}}
  </view>
</view>
