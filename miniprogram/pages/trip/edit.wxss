page {
  background-color: #fdfbf7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #2c3e2e;
}

.container {
  padding: 24rpx 32rpx 80rpx 32rpx;
}

.nav-back-btn {
  position: absolute;
  left: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e2e;
  padding: 12rpx 20rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 30rpx;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #e8e2d8;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.form-label-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #374151;
}

.required-star {
  color: #ef4444;
  margin-left: 6rpx;
  font-size: 26rpx;
}

.form-input {
  background: #fdfbf7;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #111827;
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: #8eaec7;
}

.input-placeholder {
  color: #9ca3af;
  font-size: 26rpx;
}

.form-picker {
  background: #fdfbf7;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #9ca3af;
}

.form-picker.selected {
  color: #111827;
  font-weight: 500;
}

.form-textarea {
  background: #fdfbf7;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #111827;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 50rpx;
  background: #8eaec7;
  color: #ffffff;
  padding: 28rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(142, 174, 199, 0.4);
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
